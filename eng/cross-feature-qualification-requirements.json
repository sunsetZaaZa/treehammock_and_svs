  "required_acceptance": [
    {
      "id": "finding-closure",
      "requirement": "All 84 findings have source-bound executable closure or authorized disposition; implementation status alone is insufficient."
    },
    {
      "id": "source-review",
      "requirement": "Original 451-file inventory, all added files and 181 source gates have complete current review evidence."
    },
    {
      "id": "supported-hosts",
      "requirement": "Native Windows PowerShell 7, Windows PowerShell 5.1/Desktop and supported Linux paths, including cancellation/restart/collision evidence."
    },
    {
      "id": "network-peers",
      "requirement": "Independent IPv4/IPv6/L2 and authorized SSH tunnel observations for the run-owned fixture."
    },
    {
      "id": "cross-feature-schedules",
      "requirement": "Both observed lock orders for reset/enrollment/delete/email, last-factor removal/reset, refresh/logout/grant, activation revoke/expiry/cache hit and maintenance/live-proof interactions."
    },
    {
      "id": "provider-losses",
      "requirement": "Real controlled SMTP/SMS acceptance/refusal/disconnect/late receipt and worker crash/restart observations; no customer messages."
    },
    {
      "id": "rolling-current-key-rotation",
      "requirement": "TOTP v2, outbox and operation-envelope key rotation under multiple current instances; retained-key backup/recovery evidence."
    },
    {
      "id": "fresh-recovery",
      "requirement": "Fresh current-schema setup, runtime role/grant policy and backup/restore/unknown-commit recovery drills; no development-version schema upgrades."
    },
    {
      "id": "performance",
      "requirement": "Approved COR22 budgets and measured sustained/history workloads, plans, distributions, memory/CPU/queue/pool/lock/cache/WAL/storage costs."
    },
    {
      "id": "final-image-product",
      "requirement": "Complete direct/proxy/product behavior against the exact final OCI candidate with production test capabilities disabled; startup smoke alone is insufficient."
    },
    {
      "id": "hosted-dependencies",
      "requirement": "Actual dependency/image provenance, audit results and hosted workflow/registry transport/permissions in designated disposable accounts."
    },
    {
      "id": "operator-examples",
      "requirement": "Operator grant lifecycle, deployment/recovery examples and every advertised feature exercised on the declared supported configuration."
    }
  ],
  "publication_policy": "Evidence only; no deployment, real registry promotion or ledger/gate changes"
