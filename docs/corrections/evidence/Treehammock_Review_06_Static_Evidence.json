  "secondary_index_statements": [
    "create unique index if not exists ux_accounts_email_address_lower\n    on accounts(lower(email_address));",
    "create unique index if not exists ux_accounts_username_lower\n    on accounts(lower(username))\n    where username is not null;",
    "create unique index if not exists ux_accounts_web_key\n    on accounts(web_key);",
    "create index if not exists ix_accounts_security_stamp\n    on accounts(account_id, security_stamp);",
    "create unique index if not exists ux_account_verifications_verify_key_hash\n    on account_verifications(verify_key_hash);",
