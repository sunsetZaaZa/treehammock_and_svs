# Opt in to warming Dragonfly from the database configured by DatabaseSettings.
SessionCacheWarmupSettings__Enabled=true
SessionCacheWarmupSettings__BatchSize=100
SessionCacheWarmupSettings__IntervalSeconds=10
SessionCacheWarmupSettings__DurationSeconds=300
SessionCacheWarmupSettings__CacheTtlSeconds=300
SessionCacheWarmupSettings__BatchTimeoutMilliseconds=5000

# Use your existing Yugabyte YSQL endpoint and deployed Treehammock schema.
# DatabaseSettings__servers=your-ysql-host
# DatabaseSettings__port=5433
# DatabaseSettings__database=treehammock
# DatabaseSettings__profile=Production
# DatabaseSettings__rootCertificate=/run/secrets/ysql-ca.crt
# Supply database credentials using your existing secret configuration.
