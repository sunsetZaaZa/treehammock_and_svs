# syntax=docker/dockerfile:1.7

ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
ARG DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:8.0
ARG BUILD_CONFIGURATION=Release

FROM ${DOTNET_SDK_IMAGE} AS restore
ARG BUILD_CONFIGURATION=Release
ARG TREEHAMMOCK_RELEASE_TAG
ARG TREEHAMMOCK_RELEASE_VERSION
ARG TREEHAMMOCK_RELEASE_BASE_VERSION
ARG TREEHAMMOCK_RELEASE_SOURCE_SHA
WORKDIR /src

ENV DOTNET_NOLOGO=true \
    DOTNET_CLI_TELEMETRY_OPTOUT=true \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true

# Copy the full tree for PR DOCKER-1 so locked restore can validate the
# committed packages.lock.json files generated by ./eng/restore-locks.sh.
# A later optimization PR can split this into smaller COPY layers after the
# lock files are present in every checkout.
COPY . .

RUN --mount=type=cache,id=treehammock-nuget,target=/root/.nuget/packages \
    ./eng/check-locks.sh && \
    dotnet restore treehammock.sln --locked-mode -p:Configuration="$BUILD_CONFIGURATION" \
      -p:TreehammockReleaseTag="$TREEHAMMOCK_RELEASE_TAG" \
      -p:TreehammockReleaseVersion="$TREEHAMMOCK_RELEASE_VERSION" \
      -p:TreehammockReleaseBaseVersion="$TREEHAMMOCK_RELEASE_BASE_VERSION" \
      -p:TreehammockReleaseSourceSha="$TREEHAMMOCK_RELEASE_SOURCE_SHA"

FROM restore AS build
ARG BUILD_CONFIGURATION=Release
ARG TREEHAMMOCK_BUILD_RUN_ID
ARG TREEHAMMOCK_RELEASE_TAG
ARG TREEHAMMOCK_RELEASE_VERSION
ARG TREEHAMMOCK_RELEASE_BASE_VERSION
ARG TREEHAMMOCK_RELEASE_SOURCE_SHA
WORKDIR /src

RUN --mount=type=cache,id=treehammock-nuget,target=/root/.nuget/packages \
    export TREEHAMMOCK_BUILD_RUN_ID="${TREEHAMMOCK_BUILD_RUN_ID:-$(cat /proc/sys/kernel/random/uuid)}" && \
    export TREEHAMMOCK_BUILD_CONFIGURATION="$BUILD_CONFIGURATION" && \
    printf '%s\n' "$TREEHAMMOCK_BUILD_RUN_ID" > /tmp/treehammock-build-id && \
    dotnet build treehammock.sln \
      --configuration "$BUILD_CONFIGURATION" \
      --no-restore \
      -p:ContinuousIntegrationBuild=true \
      -p:TreehammockReleaseTag="$TREEHAMMOCK_RELEASE_TAG" \
      -p:TreehammockReleaseVersion="$TREEHAMMOCK_RELEASE_VERSION" \
      -p:TreehammockReleaseBaseVersion="$TREEHAMMOCK_RELEASE_BASE_VERSION" \
      -p:TreehammockReleaseSourceSha="$TREEHAMMOCK_RELEASE_SOURCE_SHA"

FROM build AS unit-test
ARG BUILD_CONFIGURATION=Release
ARG TREEHAMMOCK_RELEASE_TAG
ARG TREEHAMMOCK_RELEASE_VERSION
ARG TREEHAMMOCK_RELEASE_BASE_VERSION
ARG TREEHAMMOCK_RELEASE_SOURCE_SHA
WORKDIR /src

RUN --mount=type=cache,id=treehammock-nuget,target=/root/.nuget/packages \
    export TREEHAMMOCK_BUILD_RUN_ID="$(cat /tmp/treehammock-build-id)" && \
    export TREEHAMMOCK_BUILD_CONFIGURATION="$BUILD_CONFIGURATION" && \
    dotnet test treehammock.Tests/treehammock.Tests.csproj \
      --configuration "$BUILD_CONFIGURATION" \
      --no-build \
      --no-restore \
      -p:TreehammockReleaseTag="$TREEHAMMOCK_RELEASE_TAG" \
      -p:TreehammockReleaseVersion="$TREEHAMMOCK_RELEASE_VERSION" \
      -p:TreehammockReleaseBaseVersion="$TREEHAMMOCK_RELEASE_BASE_VERSION" \
      -p:TreehammockReleaseSourceSha="$TREEHAMMOCK_RELEASE_SOURCE_SHA" \
      --filter "FullyQualifiedName~treehammock.Tests.Unit" \
      --logger "trx;LogFileName=treehammock-unit-tests.trx"

FROM unit-test AS publish
ARG BUILD_CONFIGURATION=Release
ARG TREEHAMMOCK_RELEASE_TAG
ARG TREEHAMMOCK_RELEASE_VERSION
ARG TREEHAMMOCK_RELEASE_BASE_VERSION
ARG TREEHAMMOCK_RELEASE_SOURCE_SHA
WORKDIR /src

RUN --mount=type=cache,id=treehammock-nuget,target=/root/.nuget/packages \
    export TREEHAMMOCK_BUILD_RUN_ID="$(cat /tmp/treehammock-build-id)" && \
    export TREEHAMMOCK_BUILD_CONFIGURATION="$BUILD_CONFIGURATION" && \
    dotnet publish treehammock.csproj \
      --configuration "$BUILD_CONFIGURATION" \
      --no-build \
      -p:UseAppHost=false \
      -p:TreehammockReleaseTag="$TREEHAMMOCK_RELEASE_TAG" \
      -p:TreehammockReleaseVersion="$TREEHAMMOCK_RELEASE_VERSION" \
      -p:TreehammockReleaseBaseVersion="$TREEHAMMOCK_RELEASE_BASE_VERSION" \
      -p:TreehammockReleaseSourceSha="$TREEHAMMOCK_RELEASE_SOURCE_SHA" \
      --output /app/publish && cp LICENSE /app/publish/LICENSE

FROM ${DOTNET_RUNTIME_IMAGE} AS api
ARG TREEHAMMOCK_RELEASE_VERSION=development
ARG TREEHAMMOCK_RELEASE_SOURCE_SHA=unknown
ARG TREEHAMMOCK_BUILD_RUN_ID
WORKDIR /app

LABEL org.opencontainers.image.title="treehammock API" \
      org.opencontainers.image.version="$TREEHAMMOCK_RELEASE_VERSION" \
      org.opencontainers.image.revision="$TREEHAMMOCK_RELEASE_SOURCE_SHA" \
      io.treehammock.build.run-id="$TREEHAMMOCK_BUILD_RUN_ID" \
      org.opencontainers.image.description="Container runtime image for the treehammock ASP.NET Core API"

ENV ASPNETCORE_ENVIRONMENT=Container \
    DOTNET_ENVIRONMENT=Container \
    ASPNETCORE_URLS=http://+:5001

COPY --from=publish /app/publish .

EXPOSE 5001

ENTRYPOINT ["dotnet", "treehammock.dll"]
