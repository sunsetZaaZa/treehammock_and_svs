{
  "AbuseCounterBundleSettings": {
    "servers": "localhost",
    "port": 6379,
    "database": 2,
    "clientName": "treehammock-api-abuse-counters",
    "allowAdmin": false,
    "reconnectRetryPolicy": 5000,
    "abortOnConnectFail": false,
    "password": "",
    "connectTimeoutMilliseconds": 1000,
    "asyncTimeoutMilliseconds": 1000,
    "syncTimeoutMilliseconds": 1000,
    "connectRetry": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SecurityOperationSettings": {
    "ActiveKeyVersion": 1,
    "HmacKeys": {
      "1": "dHJlZWhhbW1vY2stY29yMDQtdGVzdC1rZXktMDAwMDE="
    },
    "ExecutionSeconds": 30,
    "ReconciliationSeconds": 2,
    "LockSeconds": 5,
    "RetentionSeconds": 86400,
    "CleanupBatchSize": 100,
    "CleanupIntervalSeconds": 60
  },
  "RequestBodySettings": {
    "EncodedBytes": 262144,
    "DecodedBytes": 1048576,
    "ConcurrentRequests": 16,
    "ReadMilliseconds": 5000
  },
  "RegistrationSettings": {
    "PublicOrigin": "https://localhost:5001"
  },
  "SMTPSettings": {
    "TransportMode": "RequiredStartTls",
    "AllowIsolatedPlaintext": false
  },
  "DeliveryOutboxSettings": {
    "ProviderAttemptTimeoutSeconds": 10,
    "CancellationDrainSeconds": 2,
    "MaxConcurrentSends": 4
  },
  "ProviderHealthSettings": {
    "Enabled": true,
    "EmergencyEmailStop": false,
    "EmergencySmsStop": false,
    "FailureThreshold": 5,
    "WindowSeconds": 300,
    "OpenSeconds": 60,
    "PermitSeconds": 45,
    "MaxInFlightPerRoute": 32,
    "SmtpScope": "default",
    "TwilioScope": "default",
    "AwsSnsScope": "default"
  },
  "HealthProbeSettings": {
    "TotalTimeoutMilliseconds": 2000,
    "DependencyTimeoutMilliseconds": 500,
    "SampleMaxAgeMilliseconds": 250
  },
  "SessionCacheWarmupSettings": {
    "Enabled": false,
    "BatchSize": 100,
    "IntervalSeconds": 10,
    "DurationSeconds": 300,
    "CacheTtlSeconds": 300,
    "BatchTimeoutMilliseconds": 5000
  }
}
